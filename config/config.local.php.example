<?php
/**
 * Configuración local (credenciales y modo de ejecución).
 *
 * 1. Copie este archivo como  config/config.local.php
 * 2. Complete los valores. El archivo real está en .gitignore y nunca se sube al repositorio.
 *
 * Cualquier constante definida aquí tiene prioridad sobre los valores por defecto de config.php.
 * También pueden usarse variables de entorno (DB_HOST, DB_NAME, DB_USER, DB_PASS, SMTP_PASSWORD).
 */

// Producción: false. Solo poner true en un entorno de desarrollo.
define('APP_DEBUG', false);

// Base de datos
define('DB_HOST', 'localhost');
define('DB_NAME', 'nombre_de_la_base');
define('DB_USER', 'usuario_de_la_base');
define('DB_PASS', 'contraseña_de_la_base');

// Correo (SMTP)
define('SMTP_PASSWORD', 'contraseña_del_correo');
