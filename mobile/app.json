{
  "expo": {
    "name": "ID Simpatizantes",
    "slug": "id-simpatizantes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "idsimpatizantes",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.impactosdigitales.idsimpatizantes",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Se usa solo para ubicar el registro o el reporte en el mapa. Puede guardar sin ubicación.",
        "NSCameraUsageDescription": "Se usa para adjuntar una foto a un reporte.",
        "NSPhotoLibraryUsageDescription": "Se usa para adjuntar una foto a un reporte."
      }
    },
    "android": {
      "package": "com.impactosdigitales.idsimpatizantes",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se usa solo para ubicar el registro o el reporte en el mapa. Puede guardar sin ubicación."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa para adjuntar una foto a un reporte.",
          "cameraPermission": "Se usa para adjuntar una foto a un reporte."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80feeb95-314a-4604-9d77-cc8353b60e30"
      }
    },
    "owner": "impactos-digitales"
  }
}
